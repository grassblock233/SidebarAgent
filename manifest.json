{
  "manifest_version": 3,
  "name": "DeepSeek 侧边栏",
  "version": "0.4.0",
  "description": "在浏览网页时，将选中文字发送到 DeepSeek 侧边栏进行分析。",
  "permissions": [
    "contextMenus",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://api.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开 DeepSeek 侧边栏",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "minimum_chrome_version": "116"
}
